# dist/ is rebuilt locally with `npm run build` and isn't tracked on main.
# The release workflow (.github/workflows/release.yml) force-adds it onto its
# own tag commit, so jsDelivr serves it from each vX.Y.Z tag — main itself
# never carries build output.
